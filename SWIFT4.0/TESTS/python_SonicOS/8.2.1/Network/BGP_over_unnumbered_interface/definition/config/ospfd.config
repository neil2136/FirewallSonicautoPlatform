! -*- ospf -*-
!
! OSPFd sample configuration file
!
!
hostname ospfd
password zebra
!enable password please-set-at-here
!
router ospf
   ospf router-id 40.40.40.40
   redistribute static
  network 172.17.1.0/24 area 0		
!
!interface eth1
! ip ospf hello-interval 10
! ip ospf dead-interval 40
! ip ospf network broadcast

log stdout