from definition.init_param import *

class Test_01_WAN_Failover_and_Load_Balancing_TP2201_tc_112(Test):
    uuid = '1506066'
    description= show_testcase_info(Parameter.TESTPLAN, '1506066', description=True)['title']

    def test_00_show_testcase_info(self):
        show_testcase_info(Parameter.TESTPLAN, '1506066')
        Assertion.assert_equal(True, True, "ERR: show testcase info failed")
    
    def test_01_change_interface_x1_x2_default_gw(self):
        logger.info("change x1 x2 interface default gw... ")
        x2 = {
            'if': 'X2',
            'zone': 'WAN',
            'mode': 'static',
            'ip': Parameter.X2_IP,
            'netmask': '255.255.255.0',
            'gateway': Parameter.X2_GW,
            'dns1': Parameter.X1_DNS1,
            'dns2': Parameter.X1_DNS2,
            'dns3': Parameter.X1_DNS3,
            'mgmt_snmp': True,
            'mgmt_ping': True,
        }
        rc = interfaceObj.config_interface(**x2)
        Assertion.assert_equal(rc, True, "ERR: change x1 x2 interface default gw failed")
    
    def test_02_add_addr_object(self):
        logger.info('add addr object...')
        remote_l = {
            'name': 'remote_net',
            'zone': 'VPN',
            'object_type': 'network',
            'value': '{},255.255.255.0'.format(rm_x0_net),
        }
        remote_r = {
            'name': 'remote_net',
            'zone': 'VPN',
            'object_type': 'network',
            'value': '{},255.255.255.0'.format(dut_x0_net),
        }
        rc = LAddrObj.config_addressobject(**remote_l)
        logger.info('-'*10+'Add AO for rm DUT'+'-'*10)
        rc &= RAddrObj.config_addressobject(**remote_r)
        Assertion.assert_equal(rc, True, 'Add AO for DUT and RDUT Failed.')

    def test_03_add_vpn_policy_in_dut_and_remote(self):
        logger.info('add vpn policy....')
        Lvpn = {
            'type'              : 'site_to_site',
            'name'              : 'vpn_local',
            'enable'            : True,
            'auth_mode'         : 'shared_secret',
            'secret'            : '123456',
            'pri_gate'          : Parameter.REMOTE_X1,
            'local_ike_type'    : 'ipv4',
            'peer_ike_type'     : 'ipv4',
            'local_ike_id'      : '',
            'peer_ike_id'       : '',
            'local_net_type'    : 'name',
            'remote_net_type'   : 'name',
            'local_net_name'    : 'X0 Subnet',
            'remote_net_name'   : 'remote_net',
            'ike_exchange'      : 'aggressive',
            'ike_lifetime'      : '120',
            'ipsec_lifetime'    : '120',
            'keep_alive'        : True,
            'bound_to'          :['zone', 'WAN'],
        }
        Rvpn = {
            'type'              : 'site_to_site',
            'name'              : 'vpn_remote',
            'enable'            : True,
            'auth_mode'         : 'shared_secret',
            'secret'            : '123456',
            'pri_gate'          : Parameter.X1_IP,
            'sec_gate'          : Parameter.X2_IP,
            'local_ike_type'    : 'ipv4',
            'peer_ike_type'     : 'ipv4',
            'local_ike_id'      : '',
            'peer_ike_id'       : '',
            'local_net_type'    : 'name',
            'remote_net_type'   : 'name',
            'local_net_name'    : 'X0 Subnet',
            'remote_net_name'   : 'remote_net',
            'ike_exchange'      : 'aggressive',
            'ike_lifetime'      : '120',
            'ipsec_lifetime'    : '120',
            'keep_alive'        : True,
            'bound_to'          : ['zone', 'WAN'],
        }
        rc = LvpnObj.add_vpn_policy(**Lvpn)
        rc &= RvpnObj.add_vpn_policy(**Rvpn)
        Assertion.assert_equal(rc, True, 'Add vpn policy in dut and remote Failed.')

    def test_04_add_route_for_x2(self):
        logger.info('add route for x2...')
        route_dict = {
            "route_policies": [
                {
                    "ipv4": {
                        "name": "ftp",
                        "comment": "",
                        "interface": "X2",
                        "metric": 1,
                        "service": {
                            "name": "FTP"
                        },
                        "gateway": {
                            "name": "X2 Default Gateway"
                        },
                        "source": {
                            "group": "LAN Subnets"
                        },
                        "destination": {
                            "any": True
                        },
                        "disable_on_interface_down": True,
                        "vpn_precedence": False,
                        "probe": "",
                        "distance": {
                            "auto": True
                        },
                        "tos": "0x00",
                        "mask": "0x00",
                        "type": "standard"
                    }
                }
            ]
        }
        rc = routeObj.add_route_policy(**route_dict)
        Assertion.assert_equal(rc, True, "ERR: add route for x2 failed")

    def test_05_check_enable_load_balance(self):
        logger.info('uncheck enable load balance...')
        lb = {
            'enable': True
        }
        rc = failoverlbObj.config_failover_settings(**lb)
        Assertion.assert_equal(rc, True, "ERR: uncheck enable load balance failed")

    def test_06_config_LB_group(self):
        logger.info('Edit the default LB group...')
        lb = {
            "failover_lb": {
                "group": [
                    {
                        "name": " Default LB Group",
                        "type": "basic",
                        "final_backup": "",
                        "preempt": True,
                        "probing": {
                            "health_check": 5,
                            "missed_intervals": 3,
                            "successful_intervals": 3,
                            "global_responder": False
                        },
                        "interface": [
                            {
                                "name": "X1",
                                "rank": 1,
                                "probe_type": "physical"
                            },
                            {
                                "name": "X2",
                                "rank": 2,
                                "probe_type": "physical",
                                "probe_condition": "always"
                            },
                            {}
                        ]
                    }
                ]
            }
        }
        rc = failoverlbObj.config_failover_groups_by_multi(**lb)
        Assertion.assert_equal(rc, True, "ERR: edit the default LB group failed")

    def test_07_change_interface_x1_x2_default_gw(self):
        logger.info("change x1 x2 interface default gw... ")
        x1 = {
            'if': 'X1',
            'zone': 'WAN',
            'mode': 'static',
            'ip': Parameter.X1_IP,
            'netmask': '255.255.255.0',
            'gateway': Parameter.X1_GW,
            'dns1': Parameter.X1_DNS1,
            'dns2': Parameter.X1_DNS2,
            'dns3': Parameter.X1_DNS3,
            'mgmt_snmp': True,
            'mgmt_ping': True,
        }
        rc = interfaceObj.config_interface(**x1)
        Assertion.assert_equal(rc, True, "ERR: change x1 x2 interface default gw failed")

    @repeat_method(3)
    def test_08_verify_traffic_out_when_connect_to_web_server(self):
        logger.info('verify traffic out when connect to web server...')
        flag = False
        packetObj.clear_packets()
        packetObj.start_capture()
        for i in range(3):
            output=subprocess.run('curl http://{}'.format(http_server), shell=True, capture_output=True) 
            output1 = output.stdout.decode('utf-8')
            if output1:
                break
        logger.info('output1:{}'.format(output1))
        packetObj.stop_capture()
        output2 = packetObj.export_captured_packets()
        logger.info(output2)
        if re.search(r"Hello Automation", str(output1), re.S|re.I) and \
            re.search(r"Src=\[{}\], Dst=\[{}\]".format(Parameter.X1_IP, http_server), str(output2), re.S|re.I):
                 flag =  True
        Assertion.assert_equal(flag, True, "ERR: verify traffic out when connect to web server failed")

    @repeat_method(3)
    def test_09_verify_traffic_out_when_connect_to_ftp_server(self):
        logger.info('verify traffic out when connect to ftp server...')
        cmd = "echo 'this is small ftp file' > /home/ftp_112.txt"
        pc_server_ssh.send_command(cmd)
        flag = False
        packetObj.clear_packets()
        packetObj.start_capture()
        logger.info('create a new file ftp_112.txt on pc server:{}'.format(cmd))
        local_host.send_command(cmd)
        cmd = 'python3 {}'.format('{}/upload_or_download_file.py download sftp '.format(toolPath)) + '/home/ftp_112.txt '+' root ' + http_server + \
             ' /home/ftp_112.txt '  + ' password 22'
        logger.info('run cmd in pc1:{}'.format(cmd))
        local_host.send_command(cmd)
        cmd_server = 'ls -l /home'
        logger.info('run cmd in http server:{}'.format(cmd_server))
        output = local_host.send_command(cmd_server)
        packetObj.stop_capture()
        output2 = packetObj.export_captured_packets()
        logger.info(output2)
        if re.search(r".*ftp_112.txt", str(output), re.S|re.I) and \
            re.search(r"Src=\[{}\], Dst=\[{}\]".format(Parameter.X1_IP, http_server), str(output2), re.S|re.I):
            flag = True
        Assertion.assert_equal(flag, True, "ERR: send ftp traffic failed")

    @repeat_method(3)
    def test_10_verify_wan_load_balancing_statistics(self):
        logger.info('verify wan load balancing statistics...')
        flag = False
        sleep(10)
        output = failoverlbObj.check_failover_members_status()
        logger.info(output)
        if re.search(r"member_name\'\:\s\'X1", str(output[0]), re.S|re.I) and \
            re.search(r"link_status\'\:\s\'Link Up", str(output[0]), re.S|re.I) and \
            re.search(r"lb_status\'\:\s\'Available", str(output[0]), re.S|re.I) and \
            re.search(r"main_target_status\'\:\sFalse", str(output[0]), re.S|re.I) and \
            re.search(r"alternate_target_status\'\:\sFalse", str(output[0]), re.S|re.I) and \
            re.search(r"member_name\'\:\s\'X2", str(output[1]), re.S|re.I) and \
            re.search(r"link_status\'\:\s\'Link Up", str(output[1]), re.S|re.I) and \
            re.search(r"lb_status\'\:\s\'Available", str(output[1]), re.S|re.I) and \
            re.search(r"main_target_status\'\:\sFalse", str(output[1]), re.S|re.I) and \
            re.search(r"alternate_target_status\'\:\sFalse", str(output[1]), re.S|re.I)   :
            flag = True
        Assertion.assert_equal(flag, True, "ERR: verify wan load balancing statistics failed")

    
    def test_11_change_interface_x1_x2_default_gw_vpn(self):
        logger.info("change x1 x2 interface default gw vpn... ")
        x1 = {
            'if': 'X1',
            'zone': 'WAN',
            'mode': 'static',
            'ip': Parameter.X1_IP,
            'netmask': '255.255.255.0',
            'gateway': Parameter.GW_X0,
            'dns1': Parameter.X1_DNS1,
            'dns2': Parameter.X1_DNS2,
            'dns3': Parameter.X1_DNS3,
            'mgmt_snmp': True,
            'mgmt_ping': True,
        }
        x2 = {
            'if': 'X2',
            'zone': 'WAN',
            'mode': 'static',
            'ip': Parameter.X2_IP,
            'netmask': '255.255.255.0',
            'gateway': Parameter.GW_X2,
            'dns1': Parameter.X1_DNS1,
            'dns2': Parameter.X1_DNS2,
            'dns3': Parameter.X1_DNS3,
            'mgmt_snmp': True,
            'mgmt_ping': True,
        }
        rc = interfaceObj.config_interface(**x1)
        rc &= interfaceObj.config_interface(**x2)
        Assertion.assert_equal(rc, True, "ERR: change x1 x2 interface default gw vpn failed")

    @repeat_method(3)
    def test_12_verify_traffic_when_accorss_vpn_tunnel(self):
        logger.info('verify traffic out when accorss vpn tunnel...')
        flag = False
        sleep(30)
        packetObj.clear_packets()
        packetObj.start_capture()
        local_host.send_command('ping -c 5 {}'.format(Parameter.PC2_ETH0))
        packetObj.stop_capture()
        output = packetObj.export_captured_packets()
        logger.info(output)
        if re.search(r"Src=\[{}\], Dst=\[{}\]".format(Parameter.X1_IP, Parameter.REMOTE_X1), str(output), re.S|re.I) and \
            re.search(r"Src=\[{}\], Dst=\[{}\]".format( Parameter.REMOTE_X1, Parameter.X1_IP), str(output), re.S|re.I):
            flag =  True
        Assertion.assert_equal(flag, True, "ERR: verify traffic out when accorss vpn tunnel failed")


