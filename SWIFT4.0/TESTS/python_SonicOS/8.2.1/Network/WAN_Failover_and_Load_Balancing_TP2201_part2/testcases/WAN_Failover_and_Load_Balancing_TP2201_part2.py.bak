            re.search(r"alternate_target_status\'\:\sFalse", str(output[0]), re.S|re.I) and \
            re.search(r"member_name\'\:\s\'X2", str(output[1]), re.S|re.I) and \
            re.search(r"link_status\'\:\s\'Link Down", str(output[1]), re.S|re.I) and \
            re.search(r"lb_status\'\:\s\'Failover", str(output[1]), re.S|re.I) and \
            re.search(r"main_target_status\'\:\sFalse", str(output[1]), re.S|re.I) and \
            re.search(r"alternate_target_status\'\:\sFalse", str(output[1]), re.S|re.I) :
            flag = True
