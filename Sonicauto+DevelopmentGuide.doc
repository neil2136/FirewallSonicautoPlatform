<p local-id=3D"887a26b930e0"><br></p>
<p>[root@sonicauto3-backend SWIFT4.0]# mount =E2=80=93a</p>
<p local-id=3D"0891adcb955f"><br>
Add SWIFT4.0 Variables to /root/.bashrc<br><span data-colorid=3D"oyp52x04x4=
"># SWIFT4 Variables</span><br><span data-colorid=3D"ei2d8x2fs9">export SWI=
FT4=3D/p4/depot/SQA/SWIFT4.0</span><br><span data-colorid=3D"caembv92if">ex=
