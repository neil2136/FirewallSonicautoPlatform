<td data-local-id=3D"c05c026f0f0c" class=3D"confluenceTd">
<p local-id=3D"1abbaaeead5d">{ <br>
"status": 0, <br>
&lt;ac:structured-macro ac:name=3D"unmigrated-wiki-markup" ac:schema-versio=
n=3D"1" ac:macro-id=3D"b301da2b-cb75-47b1-9cd1-b03150a87cdf"&gt;&lt;ac:plai=
n-text-body&gt;&lt;![CDATA[ "message": [ <br>
]]&gt;&lt;/ac:plain-text-body&gt;&lt;/ac:structured-macro&gt;<br>
{ <br>
"aptest_session_groupid": 171, <br>
"scmlabel": "123", <br>
"group_name": "123", <br>
"productid": 6 <br>
}, <br>
{ <br>
"aptest_session_groupid": 175, <br>
"scmlabel": "20190301", <br>
"group_name": "20190301", <br>
"productid": 6 <br>
}, <br>
] <br>
}</p></td>
</tr>
