<p local-id=3D"7b2c1b3acd7a">POST</p></td>
</tr>
<tr data-local-id=3D"c189b187df73">
<td data-local-id=3D"12266cd0a8e8" class=3D"confluenceTd">
<p local-id=3D"20f354c2b361">Input parameter</p></td>
<td data-local-id=3D"d7105d34fed3" class=3D"confluenceTd">
<p local-id=3D"ad2ee774148d">scmlabel: must be string <br>
group_name : must be string <br>
productid : must be int</p></td>
</tr>
<tr data-local-id=3D"9065892674da">
