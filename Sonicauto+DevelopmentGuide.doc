n> <br><span data-colorid=3D"xr31naiqio">index index.html;</span><br><span =
data-colorid=3D"tuw56sgqaa">client_max_body_size 1024M;</span> <br><span da=
ta-colorid=3D"nuuqugv8hk">location / {</span><br><span data-colorid=3D"tnuv=
a1ltb3">try_files $uri $uri/ /index.html;</span><br><span data-colorid=3D"b=
lku5s0kul">}</span> <br><span data-colorid=3D"kb3mczqe6h">location ^~ /api/=
 {</span><br><span data-colorid=3D"pd1e4j6fuh">proxy_pass </span><a class=
=3D"external-link" href=3D"http://10.203.15.25" rel=3D"nofollow"><span data=
-colorid=3D"w80yesmhb8">http://10.203.15.25</span></a><span class=3D"conflu=
ence-embedded-file-wrapper confluence-embedded-manual-size"><img class=3D"c=
onfluence-embedded-image confluence-external-resource" height=3D"7" width=
