</tr>
<tr data-local-id=3D"3c7145a46a37">
<td data-local-id=3D"fe602c54c08b" class=3D"confluenceTd">
<p local-id=3D"fd65922c9992">Status code</p></td>
<td data-local-id=3D"230ded72f9e3" class=3D"confluenceTd">
<p local-id=3D"9b83e9e21d44">0: add data successfully <br>
1: invalid parameters or add data failed or signature has expired or permis=
sion denied</p></td>
</tr>
<tr data-local-id=3D"e13d2101df1e">
<td data-local-id=3D"b67b29a692b0" class=3D"confluenceTd">
<p local-id=3D"352bdb5b1319">Instruction</p></td>
<td data-local-id=3D"9545d9b594ef" class=3D"confluenceTd">
